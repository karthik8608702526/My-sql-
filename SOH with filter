        ('BOM5',        'IL - MH 2 Amazon',                'Amazon'),
        ('CHN',         'ILS - Chennai',                   'PV'),
        ('CJB1',        'IL - TN Amazon',                   'Amazon'),
        ('Container',   'ILWH - TN MP',                    'MP WH'),
        ('DH',          'ILS - Delhi',                     'PV'),
