aggregated_stock as (
select 
coalesce(pp_base.default_code, pp.default_code) as base_sku,
sum(sq.quantity) as current_qty
from stock_quant sq
join product_product pp on sq.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
join location_filter lf on sq.location_id = lf.id
group by coalesce(pp_base.default_code, pp.default_code)),

warehouse_location_filter as (
select l.id
from stock_location l
where l.complete_name ilike any (array['%Domestic%', 'MP1/Stock', 'SIN/Stock'])
and exists (
select 1 from stock_warehouse w 
where w.id = l.warehouse_id and w.name in ('FG Warehouse MP', 'FG Warehouse MP 1','FG Warehouse SIN')
)),

warehouse_aggregated_stock as (
select 
coalesce(pp_base.default_code, pp.default_code) as base_sku,
sum(sq.quantity) as current_qty
from stock_quant sq
join product_product pp on sq.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
join warehouse_location_filter wlf on sq.location_id = wlf.id
group by coalesce(pp_base.default_code, pp.default_code)),

warehouse_sales_invoice as (
select
coalesce(pp_base.default_code, pp.default_code) as base_sku,
sum(sol.product_uom_qty) as total_sold_3m
from sale_order_line sol
join sale_order so on sol.order_id = so.id
join product_product pp on sol.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
left join crm_team t on so.team_id = t.id
cross join date_config dc
where so.state not in ('draft', 'sent', 'cancel')
and so.date_order >= dc.start_3m
and so.date_order < dc.end_date
and (
case
when position('Amazon Sales - MA' in (t.name #>> array['en_US'])::text) > 0 then 'Amz MH'
when position('Amazon Sales - TN' in (t.name #>> array['en_US'])::text) > 0 then 'Amz TN'
when position('Amazon Sales - KA' in (t.name #>> array['en_US'])::text) > 0 then 'Amz KA'
when position('Amazon Sales FBM - TN' in (t.name #>> array['en_US'])::text) > 0 then 'Amz FBM'
when position('Local Sales - MH' in (t.name #>> array['en_US'])::text) > 0 then 'Airport'
when position('MIAL Sales' in (t.name #>> array['en_US'])::text) > 0 then 'Airport'
when position('E-Com' in (t.name #>> array['en_US'])::text) > 0 then 'Ecommerce'
when position('Ecom' in (t.name #>> array['en_US'])::text) > 0 then 'Ecommerce'
when (position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 or position('Local Sales' in (t.name #>> array['en_US'])::text) > 0) 
 and so.partner_id in (select id from res_partner where name = 'A P Exports') then 'A P Exports'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id in (30307, 230462) then 'IL Europe'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id in (30305, 216914) then 'IL UK'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 4953 then 'IF UK'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 23980 then 'IF Australia'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 132583 then 'IF Malaysia'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 23982 then 'IF Hong Kong'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 30303 then 'IF Canada'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 and so.partner_id = 2006 then 'IF USA'
when position('Export Sales' in (t.name #>> array['en_US'])::text) > 0 then 'Yantra'
when position('Local Sales' in (t.name #>> array['en_US'])::text) > 0 
and so.partner_id in (select id from res_partner where name in (
'Isha Business Pvt Ltd', 'Isha Crafts Private Limited', 'Isha Design', 'Isha Education',
'Isha Foundation', 'Isha Foundation - Delhi', 'Isha Foundation - Karnataka', 'Isha Home School',
'Isha Institute of Inner Sciences', 'Isha Life Hyderabad Yoga Studio LLP', 'Isha Outreach',
'Isha Outreach - Karnataka', 'Isha Sacred Walks', 'Isha Utsav', 'Sadhguru Academy',
'Sadhguru Academy - KA', 'Shri Yogini Trust', 'Thenkailaya Bakthi Peravai')) then 'Isha Entities'
when position('Local Sales' in (t.name #>> array['en_US'])::text) > 0 then 'B2B Vira'
else (t.name #>> array['en_US'])::text
end is not null
)
group by coalesce(pp_base.default_code, pp.default_code)),

warehouse_sales_pos as (
select
coalesce(pp_base.default_code, pp.default_code) as base_sku,
sum(pol.qty) as total_sold_3m
from pos_order_line pol
join pos_order po on pol.order_id = po.id
join product_product pp on pol.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
join account_journal aj on po.sale_journal = aj.id
cross join date_config dc
where po.state in ('done', 'invoiced', 'paid')
and po.date_order >= dc.start_3m
and po.date_order < dc.end_date
and (aj.name #>> '{}')::text ilike any (array[
'%TN Point of Sale%',
'%KA Point of Sale%',
'%UP Point of Sale%',
'%DH Point of Sale%'
])
group by coalesce(pp_base.default_code, pp.default_code)),

warehouse_aggregated_sales as (
select base_sku, sum(total_sold_3m) as total_sold_3m
from (
select * from warehouse_sales_invoice
union all
select * from warehouse_sales_pos
) t
group by base_sku),

sales_pos as (
select
coalesce(pp_base.default_code, pp.default_code) as base_sku,
sum(pol.qty) as total_sold_3m
from pos_order_line pol
join pos_order po on pol.order_id = po.id
join pos_config pc on po.config_id = pc.id
join product_product pp on pol.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
cross join date_config dc
where po.state in ('done', 'invoiced', 'paid')
and po.date_order >= dc.start_3m
and po.date_order < dc.end_date
and pc.name in (
'Isha Life Store AY',
'Isha Life Store LB',
'Isha Life Store Main',
'Isha Life Store VU',
'Isha Life Store Nalanda')
group by coalesce(pp_base.default_code, pp.default_code)),

aggregated_price as (
select
coalesce(pp_base.default_code, pp.default_code) as base_sku,
coalesce(sum(pol.price_subtotal) / nullif(sum(pol.qty), 0), 0) as avg_selling_price
from pos_order_line pol
join pos_order po on pol.order_id = po.id
join pos_config pc on po.config_id = pc.id
join product_product pp on pol.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
cross join date_config dc
where po.state in ('done', 'invoiced', 'paid')
and po.date_order >= dc.start_3m
and po.date_order < dc.end_date
and pc.name in (
'Isha Life Store AY',
'Isha Life Store LB',
'Isha Life Store Main',
'Isha Life Store VU',
'Isha Life Store Nalanda')
group by coalesce(pp_base.default_code, pp.default_code)),

aggregated_price_3y as (
select
coalesce(pp_base.default_code, pp.default_code) as base_sku,
coalesce(sum(pol.price_subtotal) / nullif(sum(pol.qty), 0), 0) as avg_selling_price_3y
from pos_order_line pol
join pos_order po on pol.order_id = po.id
join pos_config pc on po.config_id = pc.id
join product_product pp on pol.product_id = pp.id
left join product_product pp_base on 
(pp.default_code like '%-IN' or pp.default_code like '%old') 
and pp_base.default_code = regexp_replace(regexp_replace(pp.default_code, '-IN$', ''), 'old$', '')
where po.state in ('done', 'invoiced', 'paid')
and po.date_order >= date_trunc('month', current_date) - interval '3 years'
and po.date_order < date_trunc('month', current_date)::date
and pc.name in (
'Isha Life Store AY',
'Isha Life Store LB',
'Isha Life Store Main',
'Isha Life Store VU',
'Isha Life Store Nalanda')
group by coalesce(pp_base.default_code, pp.default_code)),

prepared as (
select
su.base_sku,
su.product_name,
su.l1,
su.abc as abc_classification,
coalesce(ast.current_qty, 0) as qty,
coalesce(sp.total_sold_3m, 0) as total_sold_3m,
coalesce(pr.avg_selling_price, 0) as avg_selling_price,
coalesce(pr3y.avg_selling_price_3y, 0) as avg_selling_price_3y,
-- Warehouse columns
coalesce(wast.current_qty, 0) as w_qty,
coalesce(was.total_sold_3m, 0) as w_total_sold_3m,
dc.days_3m,
dc.days_current_month
from sku_unique su
cross join date_config dc
left join aggregated_stock ast on su.base_sku = ast.base_sku
left join sales_pos sp on su.base_sku = sp.base_sku
left join aggregated_price pr on su.base_sku = pr.base_sku
left join aggregated_price_3y pr3y on su.base_sku = pr3y.base_sku
left join warehouse_aggregated_stock wast on su.base_sku = wast.base_sku
left join warehouse_aggregated_sales was on su.base_sku = was.base_sku
where coalesce(ast.current_qty, 0) != 0 
or coalesce(sp.total_sold_3m, 0) != 0)

select
product_name as "Product",
base_sku as "SKU",
l1 as "Category L1",
abc_classification as "ABC Classification",
round(avg_selling_price, 1) as "Avg Selling Price",
qty as "SOH",
round(case when days_3m > 0 then total_sold_3m / days_3m else 0 end) as "Daily Avg Sales QTY",
round(qty / nullif(case when days_3m > 0 then total_sold_3m / days_3m else 0 end, 0), 0) as "Days Coverage",
round(qty / nullif((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month, 0), 1) as "Month Coverage",
round((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month, 0) as "3M Avg Sales (Units/ Month)",
round(least(qty, (case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month), 0) as "Coverage basis P3M Avg (Units)",
round(greatest((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month - qty, 0), 0) as "Shortage (Units)",
round(greatest((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month * 1.5 - qty, 0), 0) as "Shortage to 1.5M (Units)",
round(((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month) * avg_selling_price, 0) as "3M Avg Sales (INR)",
round(least(qty, (case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month) * avg_selling_price, 0) as "Coverage basis P3M Avg (INR)",
round(greatest((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month - qty, 0) * avg_selling_price, 0) as "Shortage (INR)",
round(greatest((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month * 1.5 - qty, 0) * avg_selling_price, 0) as "Shortage to 1.5M (INR)",
round(avg_selling_price_3y, 1) as "3Y Avg Selling Price",
round(coalesce(nullif(avg_selling_price_3y, 0), avg_selling_price) * qty) as "Total Value (INR@SP)",
concat(round(
(least(qty, (case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month) * avg_selling_price 
/ nullif(((case when days_3m > 0 then total_sold_3m / days_3m else 0 end) * days_current_month) * avg_selling_price, 0)) * 100,
1), '%') as "CFR",

w_qty as "W.SOH",
round(w_qty / nullif((case when days_3m > 0 then w_total_sold_3m / days_3m else 0 end) * days_current_month, 0), 1) as "W.Month Coverage"

from prepared
where base_sku not like '%-IN' and base_sku not like '%old'
order by "Daily Avg Sales QTY" desc nulls last, "Days Coverage" asc nulls last;
