prepared as (
select
su.base_sku,
su.product_name,
su.l1,
su.abc as abc_classification,
su.target_month as target_month,
coalesce(ast.current_qty, 0) as qty,
coalesce(ast_wpi.current_qty_wpi, 0) - coalesce(ast.current_qty, 0) as qty_pi,
coalesce(ast_wpi.current_qty_wpi, 0) as qty_wpi,
coalesce(pss.qty_putaway_pending, 0) as qty_putaway_pending,
coalesce(pss.qty_qc_pending, 0) as qty_qc_pending,
coalesce(als.total_sold_6m, 0) as total_sold_6m,
coalesce(pr.avg_selling_price, 0) as avg_selling_price,
coalesce(pr3y.avg_selling_price_3y, 0) as avg_selling_price_3y,
dc.days_6m,
dc.days_current_month
from sku_unique su
cross join date_config dc
left join aggregated_stock ast on su.base_sku = ast.base_sku
left join aggregated_stock_wpi ast_wpi on su.base_sku = ast_wpi.base_sku
left join pi_stock_split pss on su.base_sku = pss.base_sku
left join aggregated_sales als on su.base_sku = als.base_sku
left join aggregated_price pr on su.base_sku = pr.base_sku
left join aggregated_price_3y pr3y on su.base_sku = pr3y.base_sku
where coalesce(ast.current_qty, 0) != 0 
or coalesce(als.total_sold_6m, 0) != 0)

select *,
case
when "Stock Index" = 0  then 'OOS'
when "Stock Index" > 0 and "Stock Index" <= 0.3 then '0-30%'
when "Stock Index" > 0.3  and "Stock Index" <= 0.5 then '30-50%'
when "Stock Index" > 0.5  and "Stock Index" <= 0.8 then '50-80%'
when "Stock Index" > 0.8  and "Stock Index" <= 1   then '80-100%'
when "Stock Index" > 1 and "Stock Index" <= 1.2 then '100-120%'
when "Stock Index" > 1.2  and "Stock Index" <= 1.5 then '120-150%'
when "Stock Index" > 1.5   then '>150%'
end as "Stock Index Bucket"
from (
select
product_name as "Product",
base_sku as "SKU",
l1 as "Category L1",
abc_classification as "ABC Classification",
round(avg_selling_price, 1) as "Avg Selling Price",
qty as "SOH",
qty_pi as "PI SOH",
qty_putaway_pending as "Pending for Putaway",
qty_qc_pending as "QC Pending",
round(case when days_6m > 0 then total_sold_6m / days_6m else 0 end) as "Daily Avg Sales QTY",
round(qty / nullif(case when days_6m > 0 then total_sold_6m / days_6m else 0 end, 0), 0) as "Days Coverage",
round(qty / nullif((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month, 0), 1) as "Month Coverage",
target_month as "Target Month Coverage",
round((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month, 0) as "6M Avg Sales (Units/ Month)",
round(least(qty, (case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month), 0) as "Coverage basis P6M Avg (Units)",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month - qty, 0), 0) as "Shortage (Units)",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month * 1.5 - qty, 0), 0) as "Shortage to 1.5M (Units)",
round(((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price, 0) as "6M Avg Sales (INR)",
round(least(qty, (case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price, 0) as "Coverage basis P6M Avg (INR)",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month - qty, 0) * avg_selling_price, 0) as "Shortage (INR)",
round(avg_selling_price_3y, 1) as "3Y Avg Selling Price",
round(coalesce(nullif(avg_selling_price_3y, 0), avg_selling_price) * qty) as "Total Value (INR@SP)",
round(coalesce(nullif(avg_selling_price_3y, 0), avg_selling_price) * qty_pi) as "PI - Total Value (INR@SP)",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month * 1.5 - qty, 0) * avg_selling_price, 0) as "Shortage to 1.5M (INR)",
concat(round(
(least(qty, (case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price 
 / nullif(((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price, 0)) * 100,
1), '%') as "CFR",
qty_wpi as "wPI SOH",
round(qty_wpi / nullif(case when days_6m > 0 then total_sold_6m / days_6m else 0 end, 0), 0) 
as "wPI Days Coverage",
round(qty_wpi / nullif((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month, 0), 1) 
as "wPI Month Coverage",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month - qty_wpi, 0), 0) 
as "wPI Shortage (Units)",
round(greatest((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month - qty_wpi, 0) * avg_selling_price, 0) 
as "wPI Shortage (INR)",
round(least(qty_wpi, (case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price, 0) 
as "wPI Coverage basis P6M Avg (INR)",
concat(round(
(least(qty_wpi, (case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price 
 / nullif(((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month) * avg_selling_price, 0)) * 100,
1), '%') as "wPI CFR",
round(qty / nullif((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month, 0), 1) / nullif(target_month, 0) as "Stock Index",
round(greatest(
(target_month - coalesce(qty_wpi / nullif((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month, 0), 0)) 
* ((case when days_6m > 0 then total_sold_6m / days_6m else 0 end) * days_current_month), 
0)::numeric, 0) as "Gap to T.SOH"

from prepared
where base_sku not like '%-IN' and base_sku not like '%old') t
order by "Daily Avg Sales QTY" desc nulls last, "Days Coverage" asc nulls last;
